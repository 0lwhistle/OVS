#!/usr/bin/env bash
#
# OVS 发布脚本：
#   ovs_release                      只完整构建（Vue + Web 打包 + 固件）
#   ovs_release --ota                构建后 OTA 推送（目标 = OVS_HOST 或 ovs.local）
#   ovs_release --ota 192.168.2.111  构建后推送到指定主机
#
# 任意目录均可执行；日常先 source scripts/env.sh 则本项目脚本全部免路径。
#
set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

# 脚本定位：无论从哪里调用都基于自身位置找项目（PATH 调用也适用）
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# 参数解析：--ota [主机]
DO_OTA=false
OTA_HOST="${OVS_HOST:-ovs.local}"
while [ $# -gt 0 ]; do
    case "$1" in
        --ota)
            DO_OTA=true
            [ -n "${2:-}" ] && ! [[ "$2" == -* ]] && OTA_HOST="$2" && shift
            ;;
        -h|--help)
            sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo -e "${RED}未知参数: $1${NC}"
            echo "用法: ovs_release [--ota [主机]]"
            exit 1
            ;;
    esac
    shift
done

if $DO_OTA; then
    echo -e "${CYAN}========================================${NC}"
    echo -e "${CYAN}  OVS Release: build → OTA push${NC}"
    echo -e "${CYAN}  目标: $OTA_HOST${NC}"
    echo -e "${CYAN}========================================${NC}"
else
    echo -e "${CYAN}========================================${NC}"
    echo -e "${CYAN}  OVS Release: build only${NC}"
    echo -e "${CYAN}  (加 --ota [主机] 可在构建后推送)${NC}"
    echo -e "${CYAN}========================================${NC}"
fi
echo ""

# ---- 完整构建（--no-flash：烧录交给串口脚本或 OTA）----
bash "$SCRIPT_DIR/mybuild.sh" --no-flash

# ---- 可选 OTA 推送 ----
if $DO_OTA; then
    echo -e "${CYAN}[Release] OTA pushing to $OTA_HOST ...${NC}"
    bash "$SCRIPT_DIR/ota_push.sh" "$OTA_HOST"

    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}  ✅ Release 完成：已构建并推送到设备${NC}"
    echo -e "${GREEN}========================================${NC}"
else
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}  ✅ Build 完成: build/ovs.bin${NC}"
    echo -e "  推送: ovs_release --ota [主机]  或  ota_push.sh [主机]${NC}"
    echo -e "${GREEN}========================================${NC}"
fi
