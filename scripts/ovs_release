#!/usr/bin/env bash
#
# OVS 发布脚本：
#   ovs_release                       只完整构建（Vue + Web 打包 + 固件 + 设备树容器）
#   ovs_release --app  --ota [主机]   编译并 OTA 更新 app 程序（不带设备树）
#   ovs_release --dtb  --ota [主机]   只打包设备树并 OTA 更新设备树（不编译固件）
#   ovs_release       --ota [主机]    编译打包，app + 设备树一起 OTA 更新
#
# 说明:
#   - --app 与 --dtb 互斥；不带它们而只给 --ota 即"app+dtb 一起升"（默认）
#   - --dtb 需要设备上已有可运行的固件（走 /api/dtb/firmware，立即生效）
#   - 主机可用 OVS_HOST 环境变量设默认；任意目录均可执行
#
set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

# 脚本定位：无论从哪里调用都基于自身位置找项目（PATH 调用也适用）
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_ROOT"

# ---- 参数解析 ----
DO_OTA=false
DO_APP=false
DO_DTB=false
OTA_HOST="${OVS_HOST:-ovs.local}"
while [ $# -gt 0 ]; do
    case "$1" in
        --ota)
            DO_OTA=true
            [ -n "${2:-}" ] && ! [[ "$2" == -* ]] && OTA_HOST="$2" && shift
            ;;
        --app)  DO_APP=true ;;
        --dtb)  DO_DTB=true ;;
        -h|--help)
            sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo -e "${RED}未知参数: $1${NC}"
            echo "用法: ovs_release [--app | --dtb] [--ota [主机]]"
            exit 1
            ;;
    esac
    shift
done

if $DO_APP && $DO_DTB; then
    echo -e "${RED}--app 与 --dtb 互斥（app+dtb 一起升请只给 --ota）${NC}"
    exit 1
fi
if $DO_DTB && ! $DO_OTA; then
    echo -e "${YELLOW}提示: --dtb 不带 --ota 时仅重新打包 build/dtb.bin，不推送${NC}"
fi

# ---- 模式横幅 ----
MODE="build only"
$DO_APP && MODE="build → OTA (app only)"
$DO_DTB && MODE="pack dtb → OTA (dtb only)"
if $DO_OTA && ! $DO_APP && ! $DO_DTB; then MODE="build → OTA (app+dtb)"; fi

echo -e "${CYAN}========================================${NC}"
echo -e "${CYAN}  OVS Release: $MODE${NC}"
$DO_OTA && echo -e "${CYAN}  目标: $OTA_HOST${NC}"
echo -e "${CYAN}========================================${NC}"
echo ""

# ---- 设备树独立模式：只打包 + 推 /api/dtb/firmware（不编译固件）----
if $DO_DTB; then
    echo -e "${CYAN}[Release] 打包设备树容器 ...${NC}"
    mkdir -p build
    python3 "$SCRIPT_DIR/pack_dtb.py" components/dtbs/config/ovs.dtb.json build/dtb.bin
    [ -f "build/dtb.bin" ] || { echo -e "${RED}dtb.bin 打包失败${NC}"; exit 1; }
    SIZE=$(stat -c%s build/dtb.bin)

    if $DO_OTA; then
        echo -e "${CYAN}[Release] 推送设备树到 $OTA_HOST （/api/dtb/firmware，立即生效）...${NC}"
        RESP=$(curl -s -m 60 -X POST --data-binary @"build/dtb.bin" \
                    -H "Content-Type: application/octet-stream" \
                    "http://$OTA_HOST/api/dtb/firmware") || {
            echo -e "${RED}❌ 推送失败（设备不可达或上传中断）${NC}"; exit 1;
        }
        echo -e "  设备响应: ${GREEN}$RESP${NC}"
        echo ""
        echo -e "${GREEN}========================================${NC}"
        echo -e "${GREEN}  ✅ 设备树更新完成（$SIZE 字节，已置 active 槽）${NC}"
        echo -e "  运行中的程序下次启动读取新树；确认槽位:"
        echo -e "  curl http://$OTA_HOST/api/ota/status | grep dtb_slot"
        echo -e "${GREEN}========================================${NC}"
    else
        echo ""
        echo -e "${GREEN}========================================${NC}"
        echo -e "${GREEN}  ✅ 设备树打包完成: build/dtb.bin ($SIZE 字节)${NC}"
        echo -e "  推送: ovs_release --dtb --ota [主机]${NC}"
        echo -e "${GREEN}========================================${NC}"
    fi
    exit 0
fi

# ---- 完整构建（--no-flash：烧录交给串口脚本或 OTA）----
bash "$SCRIPT_DIR/mybuild.sh" --no-flash

# ---- OTA 推送 ----
if $DO_OTA; then
    PUSH_ARGS=("$OTA_HOST")
    $DO_APP && PUSH_ARGS+=(--app-only)
    echo -e "${CYAN}[Release] OTA pushing to $OTA_HOST ...${NC}"
    bash "$SCRIPT_DIR/ota_push.sh" "${PUSH_ARGS[@]}"

    echo ""
    echo -e "${GREEN}========================================${NC}"
    if $DO_APP; then
        echo -e "${GREEN}  ✅ Release 完成：app 已构建并推送（设备树未动）${NC}"
    else
        echo -e "${GREEN}  ✅ Release 完成：app + 设备树已构建并推送${NC}"
    fi
    echo -e "${GREEN}========================================${NC}"
else
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}  ✅ Build 完成: build/ovs.bin + build/dtb.bin${NC}"
    echo -e "  推送: ovs_release [--app|--dtb] --ota [主机]  或  ota_push.sh [主机]${NC}"
    echo -e "${GREEN}========================================${NC}"
fi
