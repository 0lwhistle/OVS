{
    "compatible": "i2c-bus",
    "description": "I2C 总线 (触控 + ATH30)",
    
    "bus": {
        "sda_pin": 16,
        "scl_pin": 17,
        "freq_hz": 400000,
        "pullup": true,
        "pullup_resistor_ohm": 4700
    },
    
    "touchscreen": {
        "compatible": "cst816s-touch",
        "description": "CST816S 电容触控",
        "address": "0x15",
        "int_pin": 18,
        "rst_pin": 39,
        "gesture_support": true,
        "max_x": 240,
        "max_y": 280
    },
    
    "temperature_sensor": {
        "compatible": "aht30-sensor",
        "description": "AHT30 温湿度传感器",
        "address": "0x38",
        "measure_interval_ms": 1000,
        "precision": {
            "temperature": 0.3,
            "humidity": 2
        }
    }
}
