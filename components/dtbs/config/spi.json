{
    "compatible": "spi-bus",
    "description": "SPI 总线 (显示屏 + Flash)",
    
    "bus": {
        "sclk_pin": 42,
        "miso_pin": 41,
        "mosi_pin": 40,
        "max_freq_mhz": 40,
        "mode": 0
    },
    
    "lcd_display": {
        "compatible": "st7789-lcd",
        "description": "ST7789 TFT 显示屏",
        "cs_pin": 48,
        "dc_pin": 47,
        "rst_pin": 21,
        "bl_pin": 38,
        "bl_active_level": "high",
        "width": 240,
        "height": 280,
        "pixel_format": "rgb565",
        "spi_freq_mhz": 40,
        "invert_color": true,
        "rotation": 0
    },
    
    "flash": {
        "compatible": "w25q128-flash",
        "description": "W25Q128 NOR Flash",
        "cs_pin": 13,
        "size_mb": 16,
        "spi_freq_mhz": 20,
        "quad_enable": false
    }
}
